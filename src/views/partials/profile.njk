{% macro profile(displayName) %}
<svg class="profile-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <circle cx="12" cy="8" r="4"/>
    <path d="M4 21v-2a8 8 0 0 1 16 0v2"/>
</svg>
<strong>{{ displayName }}</strong>
{% endmacro %}

{% macro accountProfile(displayName, customerId) %}
{% if customerId %}<a class="profile-link" href="/my_details" aria-label="My details: {{ displayName }}">{% endif %}
{{ profile(displayName) }}
{% if customerId %}</a>{% endif %}
{% endmacro %}
