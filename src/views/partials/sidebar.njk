{% macro navLink(item) %}
<li>
    <a href="{{ item.href }}" {% if currentPath == item.href %}class="active" aria-current="page"{% endif %}>
        {{ item.label }}
    </a>
</li>
{% endmacro %}

<input type="checkbox" id="sidebar-toggle" class="sidebar-toggle-input" aria-controls="sidebar-nav">

<aside class="sidebar">
    <nav id="sidebar-nav" class="sidebar-nav" aria-label="Main navigation">
        <p class="sidebar-heading">Menu</p>
        <ul class="sidebar-links">
            {% if isAdmin %}
            {{ navLink({ href: '/admin', label: 'Admin portal' }) }}
            {% endif %}
            {% for item in navigation %}{% if not item.pinToBottom %}{{ navLink(item) }}{% endif %}{% endfor %}
        </ul>
        <ul class="sidebar-links sidebar-links-bottom">
            {% if isLoggedIn %}
            <li>
                <form method="post" action="/logout">
                    <button type="submit" id="logout-button" class="sidebar-logout">Logout</button>
                </form>
            </li>
            {% else %}
            {% for item in navigation %}{% if item.pinToBottom %}{{ navLink(item) }}{% endif %}{% endfor %}
            {% endif %}
            <li>
                <button type="button" id="theme-toggle" class="theme-toggle" role="switch" aria-checked="false" hidden>
                    <span class="theme-toggle-label">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                            <path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/>
                        </svg>
                        <span>Dark mode</span>
                    </span>
                    <span class="theme-switch-track" aria-hidden="true"></span>
                </button>
                <p id="theme-status" class="theme-status" role="status"></p>
            </li>
        </ul>
    </nav>

    <label for="sidebar-toggle" class="sidebar-toggle">
        <span class="sidebar-arrow" aria-hidden="true">&#10095;</span>
        <span class="visually-hidden">Toggle navigation menu</span>
    </label>
</aside>