{% macro passwordEye() %}
<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/>
    <circle cx="12" cy="12" r="3"/>
    <path class="password-eye-slash" d="m3 3 18 18"/>
</svg>
{% endmacro %}

{% macro passwordToggle(field, formAction) %}
{% if field.visible %}
<input type="hidden" name="visiblePasswords" value="{{ field.name }}">
{% endif %}
<button type="submit" class="password-toggle" name="togglePassword" value="{{ field.name }}"
    formaction="{{ formAction }}" formmethod="post" formnovalidate
    aria-controls="{{ field.id }}" aria-pressed="{{ 'true' if field.visible else 'false' }}"
    aria-label="{{ 'Hide' if field.visible else 'Show' }} {{ field.label | lower }}">
    {{ passwordEye() }}
</button>
{% endmacro %}

{% macro browserPasswordToggle(field) %}
<button type="button" class="password-toggle" data-password-toggle data-password-label="{{ field.label | lower }}"
    aria-controls="{{ field.id }}" aria-pressed="false" aria-label="Show {{ field.label | lower }}" hidden>
    {{ passwordEye() }}
</button>
{% endmacro %}

{# The eye buttons are submit buttons, so pressing Enter would click the first one.
   This hidden button comes first in the form so Enter submits the form instead. #}
{% macro defaultSubmit(label) %}
<button type="submit" class="default-submit" tabindex="-1" aria-hidden="true">{{ label }}</button>
{% endmacro %}
