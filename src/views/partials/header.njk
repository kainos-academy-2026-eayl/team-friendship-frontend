{% from "partials/profile.njk" import accountProfile %}
<header>
    <a href="/">
        <img src="/images/Friendshop_logo.png" alt="Team Friendship Logo" class="header-logo">
    </a>

    <a href="/">Team Friendship</a>
    {% if isLoggedIn and displayName %}
    <p class="signed-in-user">
        {{ accountProfile(displayName, customerId) }}
    </p>
    {% endif %}
    {% if not isAdmin %}
    <a class="header-basket" href="/basket" aria-label="View basket{% if basketCountUnavailable %}, item count unavailable{% else %}, {{ basketCount or 0 }} items{% endif %}">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="m7 9 5-7 5 7M3 9h18l-2 12H5L3 9ZM9 13v4M15 13v4"/>
        </svg>
        <span class="basket-count" aria-hidden="true">{{ '?' if basketCountUnavailable else (basketCount or 0) }}</span>
    </a>
    {% endif %}
</header>