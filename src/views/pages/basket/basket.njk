{% extends "layouts/main.njk" %}​
​
{% block title %}{{ page.title }}{% endblock %}​
​
{% block content %}​

<div data-basket-content>
<p class="eyebrow">{{ page.eyebrow }}</p>

<h1 id="basket-title">
    {{ page.title }}
</h1>

<p class="intro">
    {{ page.intro }}
</p>

{% if error %}
<p role="alert">{{ error }}</p>
{% endif %}

<div class="basket-items">

    {% for product in page.products %}

    <article class="basket-item">

        {% if product.image.src %}
        <img class="basket-image" src="{{ product.image.src }}" alt="{{ product.image.alt }}">
        {% else %}
        <div class="basket-image" aria-hidden="true"></div>
        {% endif %}

        <div class="basket-details">

            <h2 class="product-name">
                {{ product.name }}
            </h2>

            <p class="quantity">
                Quantity: {{ product.quantity }}
            </p>

            <form method="post" action="/basket/{{ product.basketID }}/quantity" class="basket-quantity-controls">
                <button type="submit" name="direction" value="decrease" aria-label="Decrease quantity of {{ product.name }}"{% if product.quantity <= 1 %} disabled{% endif %}>&#8722;</button>
                <button type="submit" name="direction" value="increase" aria-label="Increase quantity of {{ product.name }}"{% if not product.canIncrease %} disabled{% endif %}>+</button>
                <button type="submit" class="basket-remove" formaction="/basket/{{ product.basketID }}/remove" aria-label="Remove {{ product.name }} from basket">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7"/>
                    </svg>
                </button>
            </form>
            {% if not product.canIncrease %}<p class="basket-stock-limit" role="status">{% if product.stock == 0 %}Out of stock.{% else %}Stock limit reached ({{ product.stock }} available).{% endif %}</p>{% endif %}

            <p class="item-total">
                {{ product.totalPrice }}
            </p>

        </div>

    </article>

    {% endfor %}

</div>

<div class="basket-summary">

    <h2 class="basket-total-heading">
        Basket Total
    </h2>

    <p class="basket-total">
        {{ page.basketTotal }}
    </p>

</div>

<div class="actions">

    {% for action in page.actions %}

    {% if not error and page.products.length %}
    <a href="{{ action.href }}" id="{{ action.id }}">{{ action.label }}</a>
    {% else %}
    <button type="button" id="{{ action.id }}" disabled>{{ action.label }}</button>
    {% endif %}

    {% endfor %}

    <a href="/product_browse" class="secondary">Back to Browse</a>

</div>

<p id="status" role="status"></p>

</div>
<script src="/scripts/basket.js" defer></script>
{% endblock %} 