{% extends "layouts/main.njk" %}​
​
{% block title %}{{ page.title }}{% endblock %}​
​
{% block content %}​

<p class="eyebrow">{{ page.eyebrow }}</p>

<h1 id="basket-title">
    {{ page.title }}
</h1>

<p class="intro">
    {{ page.intro }}
</p>

{% if error %}
<p role="alert">{{ error }}</p>
{% endif %}

<div class="basket-items">

    {% for product in page.products %}

    <article class="basket-item">

        {% if product.image.src %}
        <img class="basket-image" src="{{ product.image.src }}" alt="{{ product.image.alt }}">
        {% else %}
        <div class="basket-image" aria-hidden="true"></div>
        {% endif %}

        <div class="basket-details">

            <h2 class="product-name">
                {{ product.name }}
            </h2>

            <p class="quantity">
                Quantity: {{ product.quantity }}
            </p>

            <p class="item-total">
                {{ product.totalPrice }}
            </p>

        </div>

    </article>

    {% endfor %}

</div>

<div class="basket-summary">

    <h2 class="basket-total-heading">
        Basket Total
    </h2>

    <p class="basket-total">
        {{ page.basketTotal }}
    </p>

</div>

<div class="actions">

    {% for action in page.actions %}

    {% if not error and page.products.length %}
    <a href="{{ action.href }}" id="{{ action.id }}">{{ action.label }}</a>
    {% else %}
    <button type="button" id="{{ action.id }}" disabled>{{ action.label }}</button>
    {% endif %}

    {% endfor %}

</div>

<p id="status" role="status"></p>

{% endblock %}