{% extends "layouts/main.njk" %}

{% block title %}{{ page.title }}{% endblock %}

{% block content %}


<p class="eyebrow">{{ page.eyebrow }}</p>

<h1 id="checkout-title">
    {{ page.title }}
</h1>

<p class="intro">
    {{ page.intro }}
</p>

<div class="checkout-container">

  <section class="checkout-section">
    <h2>Order Summary</h2>

    {% if error %}
    <p class="error-message" role="alert">{{ error }}</p>
    {% elif summary and summary.lines | length %}
    {% for line in summary.lines %}
    <div class="checkout-item">
      <span>{{ line.name }} × {{ line.quantity }}</span>
      <span>{{ line.lineTotal }}</span>
    </div>
    {% endfor %}

    <h3>Total: {{ summary.total }}</h3>
    {% else %}
    <p id="checkout-empty">Your basket is empty. <a href="/product_browse">Browse products</a></p>
    {% endif %}
  </section>

  <section class="checkout-section">
    <h2>Delivery Details</h2>

    <label for="first-name">First Name</label>
    <input id="first-name" type="text" placeholder="First Name">

    <label for="surname">Surname</label>
    <input id="surname" type="text" placeholder="Surname">

    <label for="address">Address</label>
    <input id="address" type="text" placeholder="Address">

    <label for="postcode">Postcode</label>
    <input id="postcode" type="text" placeholder="Postcode">

    <label for="email">Email Address</label>
    <input id="email" type="email" placeholder="Email Address">


    <h2>Payment Details</h2>

    <label for="card-number">Card Number</label>
    <input id="card-number" type="text" placeholder="Card Number">
 
    <label for="expiry-date">Expiry Date</label>
    <input id="expiry-date" type="text" placeholder="Expiry Date">
 
    <label for="cvv">CVV</label>
    <input id="cvv" type="text" placeholder="CVV">
    
   
    <button class="checkout-button" disabled>
      Place Order
    </button>
    
    <p class="checkout-note">
  Your order will be confirmed after payment is processed.
</p>
  </section>

</div>

{% endblock %}