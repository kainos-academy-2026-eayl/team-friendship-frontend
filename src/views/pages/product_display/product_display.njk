{% extends "layouts/main.njk" %}

{% block title %}{{ page.title }}{% endblock %}

{% block content %}
{% if error %}
<p class="error-message" role="alert">{{ error }}</p>
{% endif %}

{% if product %}
<img class="product-image" src="{{ product.imageUrl }}" alt="{{ product.name }}">

<h1 id="product-title">{{ product.name }}</h1>

<p class="price">£{{ product.price }}</p>

<p class="availability">
    {% if product.stock > 0 %}
    In Stock ({{ product.stock }} available)
    {% else %}
    Out of Stock
    {% endif %}
</p>

<p class="intro">
    {{ product.description }}
</p>

<form id="product-form" action="/basket" method="post">
    <input id="quantity" name="quantity" type="number" min="1" value="1" required>

    <button class="add-to-basket" type="submit" data-product-id="{{ product.id }}">
        Add to Basket
    </button>
</form>

<div class="actions">
    {% for action in page.actions %}
    {% if action.href %}
    <a href="{{ action.href }}" id="{{ action.id }}" class="{{ action.className }}">{{ action.label }}</a>
    {% else %}
    <button type="{{ action.type }}" id="{{ action.id }}" {% if action.className %}class="{{ action.className }}"{% endif %} {% if action.disabled %}disabled{% endif %}>{{ action.label }}</button>
    {% endif %}
    {% endfor %}
</div>

<p id="status" role="status"></p>
{% endif %}
{% endblock %}
