{% extends "layouts/main.njk" %}

{% block title %}{{ page.title }}{% endblock %}

{% block content %}
{% from "partials/password_toggle.njk" import passwordToggle %}
<p class="eyebrow">{{ page.eyebrow }}</p>
<h1 id="reset-password-title">{{ page.title }}</h1>

<form id="reset-password-form" method="post" action="/reset_password" novalidate>
    <input type="hidden" name="token" value="{{ token }}">
    <label for="reset-email">Email Address</label>
    <input id="reset-email" name="email" type="email" autocomplete="email"
        value="{{ email }}" readonly aria-describedby="reset-email-help">
    <p id="reset-email-help">This email address cannot be changed.</p>

    {% for field in page.fields %}
    {% set fieldErrors = errors[field.name] if errors else undefined %}
    <label for="{{ field.id }}">{{ field.label }}</label>
    <div class="password-field">
        <input id="{{ field.id }}" name="{{ field.name }}" type="password"
            autocomplete="new-password" placeholder="{{ field.placeholder }}"
            {% if fieldErrors %}aria-invalid="true" aria-describedby="{{ field.id }}-error"{% endif %}>
        {{ passwordToggle(field.id, field.label) }}
    </div>
    {% if fieldErrors %}
    <ul id="{{ field.id }}-error" class="error reset-password-errors">
        {% for message in fieldErrors %}
        <li>{{ message }}</li>
        {% endfor %}
    </ul>
    {% endif %}
    {% endfor %}

    <a href="/login" class="forgot-password">Back to Login</a>
    <div class="actions">
        <button type="submit" id="reset-password-submit">Reset Password</button>
    </div>
</form>
<p id="status" role="status">{{ message }}</p>

<script src="/scripts/password-toggle.js" defer></script>
{% endblock %}