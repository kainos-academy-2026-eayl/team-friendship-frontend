{# Product page: shows product details and a quantity form. #}
{% extends "layouts/main.njk" %}​
​
{% block title %}{{ page.title }}{% endblock %}​
​
{% block content %}​

<p class="eyebrow">{{ page.eyebrow }}</p>

{# Only render the image when one is provided #}
{% if page.image.src %}
<img class="product-image" src="{{ page.image.src }}" alt="{{ page.image.alt }}">
{% endif %}

<h1 id="product-title">{{ page.title }}</h1>

<p class="price">{{ page.price }}</p>

<p class="availability">
    {{ page.availability }}
</p>

<p class="intro">
    {{ page.description }}
</p>

{# Quantity selection, minimum of 1 #}
<form id="product-form">

    <label for="quantity">
        Quantity
    </label>

    <input id="quantity" name="quantity" type="number" min="1" value="1" required>

    {# Buttons are rendered from page.actions #}
    <div class="actions">

        {% for action in page.actions %}
        <button type="{{ action.type }}" id="{{ action.id }}" {% if action.className %}class="{{ action.className }}"
            {% endif %} {% if action.disabled %}disabled{% endif %}>{{ action.label }}</button>
        {% endfor %}

    </div>

</form>

{# Live region for status messages #}
<p id="status" role="status"></p>

{% endblock %}