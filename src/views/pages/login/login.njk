{% extends "layouts/main.njk" %}​
​
{% block title %}{{ page.title }}{% endblock %}​
​
{% block content %}​
{% from "partials/password_toggle.njk" import passwordToggle, defaultSubmit %}

{% if alreadyLoggedIn %}
<h1 id="login-title">Already logged in</h1>
<p id="status" role="status">You are already logged in.</p>
{% else %}
<p class="eyebrow">{{ page.eyebrow }}</p>
<h1 id="login-title">{{ page.title }}</h1>
<p class="intro">{{ page.intro }}</p>

<form id="login-form" method="post" action="/login">
    {{ defaultSubmit('Login') }}
    {% if returnTo %}
    <input type="hidden" name="returnTo" value="{{ returnTo }}">
    {% endif %}
    {% for field in page.fields %}
    <label for="{{ field.id }}">{{ field.label }}</label>
    {% if field.type == 'password' %}
    <div class="password-field">
        <input id="{{ field.id }}" name="{{ field.name }}" type="{{ 'text' if field.visible else 'password' }}"
            value="{{ field.value }}" autocomplete="{{ field.autocomplete }}" placeholder="{{ field.placeholder }}"
            required>
        {{ passwordToggle(field, '/login/toggle-password') }}
    </div>
    {% else %}
    <input id="{{ field.id }}" name="{{ field.name }}" type="{{ field.type }}" value="{{ field.value }}"
        autocomplete="{{ field.autocomplete }}" placeholder="{{ field.placeholder }}" required>
    {% endif %}
    {% endfor %}

    <a href="/forgot_password" class="forgot-password" id="{{ page.forgotPassword.id }}">
        {{ page.forgotPassword.label }}
    </a>

    <div class="actions">
        {% for action in page.actions %}
        {% if action.href %}
        <a href="{{ action.href }}" id="{{ action.id }}" class="{{ action.className }}">{{ action.label }}</a>
        {% else %}
        <button type="{{ action.type }}" id="{{ action.id }}" {% if action.className %}class="{{ action.className }}"
            {% endif %} {% if action.disabled %}disabled{% endif %}>{{ action.label }}</button>
        {% endif %}
        {% endfor %}
    </div>
</form>
<p id="status" role="status">{% if error %}{{ error }}{% elif success %}{{ success }}{% endif %}</p>
{% endif %}



{% endblock %}