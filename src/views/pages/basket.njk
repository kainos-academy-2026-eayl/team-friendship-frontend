{# Basket page: lists basket items, the basket total and the page actions. #}
{% extends "layouts/main.njk" %}​
​
{% block title %}{{ page.title }}{% endblock %}​
​
{% block content %}​

<p class="eyebrow">{{ page.eyebrow }}</p>

<h1 id="basket-title">
    {{ page.title }}
</h1>

<p class="intro">
    {{ page.intro }}
</p>

{# One article per product in the basket #}
<div class="basket-items">

    {% for product in page.products %}

    <article class="basket-item">

        {# Fall back to an empty placeholder when the product has no image #}
        {% if product.image.src %}
        <img class="basket-image" src="{{ product.image.src }}" alt="{{ product.image.alt }}">
        {% else %}
        <div class="basket-image" aria-hidden="true"></div>
        {% endif %}

        <div class="basket-details">

            <h2 class="product-name">
                {{ product.name }}
            </h2>

            <p class="quantity">
                Quantity: {{ product.quantity }}
            </p>

            <p class="item-total">
                {{ product.totalPrice }}
            </p>

        </div>

    </article>

    {% endfor %}

</div>

{# Basket total summary #}
<div class="basket-summary">

    <h2 class="basket-total-heading">
        Basket Total
    </h2>

    <p class="basket-total">
        {{ page.basketTotal }}
    </p>

</div>

{# Buttons are rendered from page.actions #}
<div class="actions">

    {% for action in page.actions %}

    <button type="{{ action.type }}" id="{{ action.id }}" {% if action.className %}class="{{ action.className }}"
        {% endif %} {% if action.disabled %}disabled{% endif %}>
        {{ action.label }}
    </button>

    {% endfor %}

</div>

{# Live region for status messages #}
<p id="status" role="status"></p>

{% endblock %}