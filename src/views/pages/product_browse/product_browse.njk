{% extends "layouts/main.njk" %}​
​
{% block title %}{{ page.title }}{% endblock %}​
​
{% block content %}​

<h1 class="page-title">Browse Products</h1>

<section class="search-section">
    <form method="GET" class="search-form">
        <input type="text" name="search" class="search-input" placeholder="Search products..." value="{{ searchTerm }}"
            aria-label="Search products">
        <label for="category" class="sort-label">Category</label>
        <select id="category" name="category" class="sort-select">
            <option value="" {% if not category %}selected{% endif %}>All categories</option>
            {% for cat in categories %}
            <option value="{{ cat }}" {% if category and category | lower == cat | lower %}selected{% endif %}>{{ cat }}</option>
            {% endfor %}
        </select>
        <label for="sort" class="sort-label">Sort by</label>
        <select id="sort" name="sort" class="sort-select">
            <option value="" {% if not sort %}selected{% endif %}>Default</option>
            <option value="category-asc" {% if sort == "category-asc" %}selected{% endif %}>Category (A–Z)</option>
            <option value="category-desc" {% if sort == "category-desc" %}selected{% endif %}>Category (Z–A)</option>
        </select>
        <button type="submit" class="search-button">
            Search
        </button>
    </form>
</section>
{% if error %}
<p class="error-message" role="alert">{{ error }}</p>
{% endif %}
{% if products.length > 0 %}
<section class="product-grid">

    {% for product in products %}
    <article class="product-card">

        <img src="{{ product.imageUrl }}" alt="{{ product.name }}" class="product-image">

        <div class="product-details">
            <h2 class="product-name">
                {{ product.name }}
            </h2>

            <p class="product-category">
                {{ product.category }}
            </p>

            <p class="product-price">
                £{{ product.price }}
            </p>
            {% if product.stock == 0 %}<p class="availability">Out of Stock</p>{% endif %}

            <a href="/products/{{ product.id }}" class="view-product-button" id="view-product-button">
                View Details
            </a>
        </div>

    </article>
    {% endfor %}

</section>

{% else %}
<section class="no-results">
    <p>No products found.</p>
</section>
{% endif %}

<section class="navigation">
    <button type="button" class="navigator" onclick="window.location.href='/home'">
        Logout
    </button>
</section>

{% endblock %}