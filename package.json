{
  "name": "team-friendship-frontend",
  "version": "1.0.0",
  "description": "Frontend for team friendship",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js --sourcemap && cp src/index.html dist/index.html",
    "typecheck": "tsc",
    "start": "node dist/index.js",
    "format": "biome format .",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "test": "vitest run",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Team Friendship",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1"
  }
}
