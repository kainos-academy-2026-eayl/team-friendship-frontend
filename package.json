{
  "name": "team-friendship-frontend",
  "version": "1.0.0",
  "description": "Frontend for team friendship",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build:client -- --watch & tsx watch src/index.ts",
    "build:client": "esbuild login=src/controllers/loginController.ts register=src/controllers/registerController.ts --bundle --platform=browser --target=es2023 --outdir=public/scripts --sourcemap",
    "build": "npm run typecheck && npm run build:client && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js --sourcemap",
    "typecheck": "tsc",
    "start": "node dist/index.js",
    "format": "biome format .",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "test": "vitest run",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Team Friendship",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/nunjucks": "^3.2.6",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "approve": "^0.0.12",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "nunjucks": "^3.2.4",
    "scripts": "^0.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}