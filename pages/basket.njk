<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page.title }}</title>
    <link rel="stylesheet" href="/ecommerce.css">
</head>

<body>
    <main aria-labelledby="basket-title">

        <p class="eyebrow">{{ page.eyebrow }}</p>

        <h1 id="basket-title">
            {{ page.title }}
        </h1>

        <p class="intro">
            {{ page.intro }}
        </p>

        <div class="basket-items">

            {% for product in page.products %}

            <article class="basket-item">

                {% if product.image.src %}
                <img class="basket-image" src="{{ product.image.src }}" alt="{{ product.image.alt }}">
                {% else %}
                <div class="basket-image" aria-hidden="true"></div>
                {% endif %}

                <div class="basket-details">

                    <h2 class="product-name">
                        {{ product.name }}
                    </h2>

                    <p class="quantity">
                        Quantity: {{ product.quantity }}
                    </p>

                    <p class="item-total">
                        {{ product.totalPrice }}
                    </p>

                </div>

            </article>

            {% endfor %}

        </div>

        <div class="basket-summary">

            <h2 class="basket-total-heading">
                Basket Total
            </h2>

            <p class="basket-total">
                {{ page.basketTotal }}
            </p>

        </div>

        <div class="actions">

            {% for action in page.actions %}

            <button type="{{ action.type }}" id="{{ action.id }}"
                {% if action.className %}class="{{ action.className }}" {% endif %}
                {% if action.disabled %}disabled{% endif %}>
                {{ action.label }}
            </button>

            {% endfor %}

        </div>

        <p id="status" role="status"></p>

    </main>
</body>

</html>